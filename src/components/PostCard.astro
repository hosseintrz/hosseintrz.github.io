---
import Card from '@/components/Card.astro';
import Tag from '@/components/Tag.astro';
import DraftBadge from '@/components/DraftBadge.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const href = `/blog/${post.id}/`;
---

<Card href={href}>
  <article class="p-5">
    <div class="flex items-center gap-3 text-xs text-text-3">
      <span class="inline-flex items-center gap-1.5">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </span>
      {post.data.draft && <DraftBadge />}
    </div>
    <h3 class="mt-2 font-display text-lg font-semibold leading-snug tracking-tight">
      {post.data.title}
    </h3>
    <p class="mt-1.5 line-clamp-2 text-sm text-text-2">{post.data.description}</p>
    {
      post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {post.data.tags.map((t) => (
            <Tag label={t} />
          ))}
        </div>
      )
    }
  </article>
</Card>
---
interface Props {
  href?: string;
  hover?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { href, hover = true, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'div';
const classes = ['card', hover && href ? 'card-hover' : '', className ?? ''];
---

<Tag href={href} class={classes.join(' ').trim()} {...rest}>
  <slot />
</Tag>
---
/**
 * Command palette (Ctrl/Cmd+K): static page index + Pagefind full-text
 * search + quick actions. Pagefind is lazily loaded from /pagefind/
 * (generated in postbuild). Results render in a native <dialog>.
 */
import Icon from '@/components/Icon.astro';
---

<dialog id="cmdk" class="cmdk" aria-label="Command palette — search and navigation">
  <div class="cmdk-panel">
    <div class="cmdk-head">
      <Icon name="search" size={16} />
      <input
        id="cmdk-input"
        type="text"
        placeholder="Search posts, projects, pages…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search"
      />
      <kbd>esc</kbd>
    </div>
    <ul id="cmdk-results" role="listbox" aria-label="Results"></ul>
    <div class="cmdk-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
    </div>
  </div>
</dialog>

<style>
  .cmdk {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
  }
  .cmdk::backdrop {
    background: color-mix(in oklab, var(--surface-0) 60%, transparent);
    backdrop-filter: blur(2px);
  }
  .cmdk-panel {
    margin: 12vh auto 0;
    width: min(92vw, 40rem);
    background-color: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }
  .cmdk-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-3);
  }
  .cmdk-head input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    color: var(--text-3);
    background: var(--surface-2);
  }
  #cmdk-results {
    list-style: none;
    margin: 0;
    padding: 0.375rem;
    max-height: 46vh;
    overflow-y: auto;
  }
  #cmdk-results :global(li) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--r-md);
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-2);
  }
  #cmdk-results :global(li[data-selected='true']) {
    background-color: var(--accent-soft);
    color: var(--text-1);
  }
  #cmdk-results :global(.cmdk-type) {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    min-width: 4.5rem;
  }
  #cmdk-results :global(.cmdk-hint) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #cmdk-results :global(.cmdk-empty) {
    justify-content: center;
    color: var(--text-3);
    cursor: default;
  }
  .cmdk-foot {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .cmdk-foot kbd {
    margin-right: 0.2rem;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { applyPref, getPref, setAccent, ACCENTS } from '@/scripts/ui';

  interface Item {
    title: string;
    url?: string;
    type: string;
    hint?: string;
    excerpt?: string;
    action?: () => void;
  }

  const dialog = document.getElementById('cmdk') as HTMLDialogElement;
  const input = document.getElementById('cmdk-input') as HTMLInputElement;
  const list = document.getElementById('cmdk-results') as HTMLUListElement;

  let pageIndex: Item[] = [];
  let indexLoaded = false;
  let pagefind: {
    search: (q: string) => Promise<{
      results: Array<{ data: () => Promise<{ url: string; meta?: { title?: string }; excerpt?: string }> }>;
    }>;
  } | null = null;
  let pagefindTried = false;

  async function loadIndex(): Promise<void> {
    if (indexLoaded) return;
    indexLoaded = true;
    try {
      const res = await fetch('/search-index.json');
      pageIndex = (await res.json()) as Item[];
    } catch {
      pageIndex = [];
    }
  }

  async function loadPagefind(): Promise<void> {
    if (pagefindTried) return;
    pagefindTried = true;
    try {
      // Variable form (defeats static analysis): /pagefind/ is generated in postbuild.
      const pagefindUrl = '/pagefind/pagefind.js';
      const mod = await import(/* @vite-ignore */ pagefindUrl);
      pagefind = mod?.search ? mod : null;
    } catch {
      pagefind = null; // dev mode or postbuild not run — static index still works
    }
  }

  function actions(): Item[] {
    return [
      {
        title: 'Toggle theme (dark / light / system)',
        type: 'action',
        action: () => applyPref(getPref() === 'dark' ? 'light' : getPref() === 'light' ? 'system' : 'dark'),
      },
      {
        title: 'Next accent color',
        type: 'action',
        action: () => {
          const i = (ACCENTS as readonly string[]).indexOf(
            document.documentElement.dataset.accent ?? 'violet'
          );
          setAccent((ACCENTS as readonly string[])[(i + 1) % ACCENTS.length]);
        },
      },
    ];
  }

  let items: Item[] = [];
  let selected = 0;

  function render(): void {
    list.innerHTML = '';
    if (items.length === 0) {
      const li = document.createElement('li');
      li.className = 'cmdk-empty';
      li.textContent = input.value ? 'No results.' : 'Type to search, or pick a destination.';
      list.appendChild(li);
      return;
    }
    items.forEach((item, i) => {
      const li = document.createElement('li');
      li.dataset.selected = String(i === selected);
      li.setAttribute('role', 'option');
      li.dataset.url = item.url ?? '';
      const type = document.createElement('span');
      type.className = 'cmdk-type';
      type.textContent = item.type;
      const title = document.createElement('span');
      title.textContent = item.title;
      li.append(type, title);
      if (item.hint) {
        const hint = document.createElement('span');
        hint.className = 'cmdk-hint';
        hint.textContent = item.hint;
        li.appendChild(hint);
      }
      list.appendChild(li);
    });
  }

  function pick(): void {
    const item = items[selected];
    if (!item) return;
    dialog.close();
    if (item.action) {
      item.action();
    } else if (item.url) {
      navigate(item.url);
    }
  }

  function move(delta: number): void {
    if (items.length === 0) return;
    selected = (selected + delta + items.length) % items.length;
    render();
    list
      .querySelector(`li[data-selected='true']`)
      ?.scrollIntoView({ block: 'nearest' });
  }

  async function update(): Promise<void> {
    const q = input.value.trim().toLowerCase();
    if (!q) {
      items = [...pageIndex.filter((i) => i.type === 'page'), ...actions()];
      selected = 0;
      render();
      return;
    }

    const staticHits = pageIndex
      .filter((i) => i.title.toLowerCase().includes(q) || (i.hint ?? '').toLowerCase().includes(q))
      .slice(0, 6);

    let contentHits: Item[] = [];
    await loadPagefind();
    if (pagefind && q.length >= 2) {
      try {
        const res = await pagefind.search(q);
        const data = await Promise.all(res.results.slice(0, 5).map((r) => r.data()));
        contentHits = data.map((d) => ({
          title: d.meta?.title ?? d.url,
          url: d.url,
          type: 'text',
          excerpt: d.excerpt,
        }));
      } catch {
        /* pagefind unavailable */
      }
    }

    const seen = new Set<string>();
    items = [...staticHits, ...contentHits].filter((i) => {
      if (seen.has(i.url ?? i.title)) return false;
      seen.add(i.url ?? i.title);
      return true;
    });
    selected = 0;
    render();
  }

  async function open(): Promise<void> {
    await loadIndex();
    input.value = '';
    await update();
    dialog.showModal();
    input.focus();
  }

  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;
    if (target.closest('[data-cmdk-open]')) {
      e.preventDefault();
      void open();
      return;
    }
    if (dialog.open && !target.closest('.cmdk-panel')) dialog.close();
    const li = target.closest<HTMLLIElement>('#cmdk-results li[data-url]');
    if (li && li.dataset.url) {
      dialog.close();
      navigate(li.dataset.url);
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog.open) dialog.close();
      else void open();
      return;
    }
    if (!dialog.open) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      move(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      move(-1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      pick();
    }
  });

  input.addEventListener('input', () => void update());
</script>
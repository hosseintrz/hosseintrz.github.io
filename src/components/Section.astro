---
interface Props {
  title?: string;
  subtitle?: string;
  id?: string;
  reveal?: boolean;
  class?: string;
}

const { title, subtitle, id, reveal = true, class: className } = Astro.props;
---

<section id={id} class:list={['py-12 sm:py-16', className]} data-reveal={reveal ? '' : undefined}>
  {
    (title || subtitle) && (
      <div class="mb-6">
        {title && <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>}
        {subtitle && <p class="mt-2 max-w-2xl text-text-2">{subtitle}</p>}
      </div>
    )
  }
  <slot />
</section>
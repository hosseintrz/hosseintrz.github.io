---
interface Props {
  size?: 'narrow' | 'wide' | 'full';
  class?: string;
}

const { size = 'narrow', class: className } = Astro.props;
const widths = {
  narrow: 'max-w-3xl',
  wide: 'max-w-6xl',
  full: 'max-w-7xl',
} as const;
---

<div class:list={['mx-auto w-full px-4 sm:px-6', widths[size], className]}>
  <slot />
</div>
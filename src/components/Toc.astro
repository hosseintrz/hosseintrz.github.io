---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const show = toc.length >= 2;
---

{
  show && (
    <nav class="toc text-sm" aria-label="Table of contents">
      <p class="font-mono text-xs uppercase tracking-wider text-text-3">On this page</p>
      <ul class="mt-3 space-y-1.5 border-l border-border">
        {toc.map((h) => (
          <li class={h.depth === 3 ? 'ml-4' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link={`#${h.slug}`}
              class="block border-l-2 border-transparent py-0.5 pl-3 text-text-2 no-underline transition-colors hover:text-text-1"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Highlight the section currently in view.
  function setupToc() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (links.length === 0) return;
    const targets = links
      .map((l) => document.querySelector<HTMLElement>(l.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => !!el);
    if (targets.length === 0) return;

    const setActive = (id: string) => {
      for (const link of links) {
        const active = link.dataset.tocLink === `#${id}`;
        link.classList.toggle('toc-active', active);
        link.setAttribute('aria-current', active ? 'true' : 'false');
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        // pick the first heading visible near the top
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
    );
    targets.forEach((t) => io.observe(t));
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>

<style>
  :global(.toc-active) {
    border-color: var(--accent) !important;
    color: var(--accent);
  }
</style>
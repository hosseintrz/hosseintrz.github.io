---
/**
 * Optional giscus comments (GitHub Discussions). Disabled by default;
 * enable in src/config/site.ts (features.comments) and fill repo ids.
 */
import { site } from '@/config/site';

const { enabled, repo, repoId, category, categoryId } = site.features.comments;
const enabledForReal = enabled && repo && repoId && category && categoryId;
---

{
  enabledForReal && (
    <section class="mt-12 border-t border-border pt-8 no-print" aria-label="Comments">
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="en"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    </section>
  )
}
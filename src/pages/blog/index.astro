---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import PostCard from '@/components/PostCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import Tag from '@/components/Tag.astro';
import { getCollection } from 'astro:content';
import { sortPostsDesc } from '@/lib/sort';
import { groupByYear, uniqueTags, visibleDrafts } from '@/lib/group';

const isDev = import.meta.env.DEV;
const all = sortPostsDesc(await getCollection('blog'));
const posts = visibleDrafts(all, isDev);
const tags = uniqueTags(posts);
const years = groupByYear(posts);
---

<BaseLayout title="Blog" description="Writing on engineering, Go, AI agents, and lessons from shipping.">
  <Container class="py-12 sm:py-16">
    <header class="max-w-2xl" data-reveal>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Blog</h1>
      <p class="mt-4 text-lg text-text-2">
        Notes from building things — cloud platforms, Go services, AI agents,
        and the occasional lesson learned the hard way.
      </p>
    </header>

    {
      tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2" data-reveal>
          {tags.map(({ tag, count }) => (
            <Tag label={`${tag} (${count})`} href={`/blog/tags/${tag}/`} />
          ))}
        </div>
      )
    }

    <div class="mt-12 space-y-12" data-reveal>
      {
        years.length > 0 ? (
          years.map(({ year, items }) => (
            <section aria-label={`Posts from ${year}`}>
              <h2 class="font-mono text-sm uppercase tracking-wider text-text-3">{year}</h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {items.map((p) => (
                  <PostCard post={p} />
                ))}
              </div>
            </section>
          ))
        ) : (
          <EmptyState
            icon="file-text"
            title="No posts yet"
            message="Writing in progress. In the meantime, the RSS feed will light up first."
          />
        )
      }
    </div>
  </Container>
</BaseLayout>
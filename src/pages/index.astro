---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import Link from '@/components/Link.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostCard from '@/components/PostCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { getCollection } from 'astro:content';
import { sortPostsDesc, sortProjects } from '@/lib/sort';
import { pickFeatured, visibleDrafts } from '@/lib/group';

const isDev = import.meta.env.DEV;

const projects = visibleDrafts(
  sortProjects(await getCollection('projects')),
  isDev
);
const posts = visibleDrafts(sortPostsDesc(await getCollection('blog')), isDev);
const featured = pickFeatured(projects, 3);
const latest = posts.slice(0, 3);
const reading = visibleDrafts(
  (await getCollection('books')).filter((b) => b.data.status === 'reading'),
  isDev
);
---

<BaseLayout description={site.description}>
  <Container size="wide" class="py-10 sm:py-14">
    <!-- hero -->
    <section class="relative" data-reveal>
      <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center">
        <img
          src={site.photo}
          alt={`Portrait of ${site.name}`}
          width="112"
          height="112"
          class="size-28 shrink-0 rounded-full border border-border object-cover shadow-sm"
        />
        <div class="min-w-0">
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            Hi, I'm {site.name}.
          </h1>
          <p class="mt-3 max-w-xl text-lg text-text-2">{site.tagline}</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Button href="/resume">Resume</Button>
            <Button href="/blog" variant="ghost">
              Read the blog <Icon name="arrow-right" size={15} />
            </Button>
            <Link href={site.github} class="inline-flex items-center gap-1.5 text-sm no-underline text-text-2 hover:text-text-1">
              <Icon name="github" size={16} /> {site.githubUser}
            </Link>
          </div>
        </div>
      </div>
    </section>

    <!-- featured projects -->
    <Section title="Featured projects" class="!py-12">
      {
        featured.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        ) : (
          <EmptyState
            icon="layers"
            title="No featured projects yet"
            message="Projects are being written up. Check /projects for the full grid."
          />
        )
      }
      <p class="mt-4 text-sm">
        <Link href="/projects" class="inline-flex items-center gap-1">
          All projects <Icon name="arrow-right" size={14} />
        </Link>
      </p>
    </Section>

    <!-- latest posts -->
    <Section title="Latest posts" class="!py-12">
      {
        latest.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {latest.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        ) : (
          <EmptyState
            icon="file-text"
            title="No posts yet"
            message="Writing in progress — the first posts are in the works."
          />
        )
      }
      <p class="mt-4 text-sm">
        <Link href="/blog" class="inline-flex items-center gap-1">
          All posts <Icon name="arrow-right" size={14} />
        </Link>
      </p>
    </Section>

    <!-- currently reading -->
    <Section title="Currently reading" class="!py-12">
      {
        reading.length > 0 ? (
          <ul class="grid gap-4 sm:grid-cols-2">
            {reading.map((b) => (
              <li class="card p-5">
                <p class="font-display font-semibold">{b.data.title}</p>
                <p class="text-sm text-text-3">{b.data.author}</p>
                <p class="mt-2 text-sm text-text-2">{b.data.oneLiner}</p>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState
            icon="book"
            title="Nothing mid-read right now"
            message="See what I've finished on the library page."
          />
        )
      }
      <p class="mt-4 text-sm">
        <Link href="/library/books" class="inline-flex items-center gap-1">
          The library <Icon name="arrow-right" size={14} />
        </Link>
      </p>
    </Section>
  </Container>
</BaseLayout>
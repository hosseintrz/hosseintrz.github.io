---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="404" description="Page not found." noindex>
  <Container class="py-24 sm:py-32">
    <div class="mx-auto max-w-xl text-center" data-reveal>
      <p class="font-mono text-7xl font-bold tracking-tighter text-accent sm:text-8xl">404</p>
      <h1 class="mt-6 font-display text-2xl font-semibold tracking-tight">
        This route returned an empty index.
      </h1>
      <p class="mt-3 text-text-2">
        The page you're looking for doesn't exist — maybe it was renamed, or
        maybe it never passed CI.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/">
          Back home <Icon name="arrow-right" size={15} />
        </Button>
        <Button href="/blog" variant="ghost">Read the blog</Button>
      </div>
    </div>
  </Container>
</BaseLayout>